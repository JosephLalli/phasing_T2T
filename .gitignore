# Gitignore file itself
.gitignore
.dockerignore

# Claude-related files
*claude*
*CLAUDE*
DIRECTORY_LOGIC.md

# Python cache
__pycache__/

# Quarto files
.Quarto
_quarto.yml


# Symlinks
*.lnk

## Input files -- too large
*unphased_variant_calls/**
*phased_panels/**
*fullgenome*
*_working_*
*SHAPEIT5_switch_output*
*imputation_statistics/*
resources/GRCh38_full_analysis_set_plus_decoy_hla.fa.gz*
resources/chm13v2.0.fa.gz*
t2t_native_scaled_maps.tar.gz
**/*.fully_annotated.tsv

# Large genomic data files (symlinks >50MB)
resources/hgsvc3-*
resources/hprc-v1.1-*

## Intermediate data - too large (>50MB parquets)
**/all_variant_data.parquet
**/bcftools_query_variant_data.parquet
intermediate_data_whole_genome/rolling_stats_*parquet
intermediate_data_whole_genome/variants.parquet
intermediate_data_whole_genome/MAF_performance_variants.parquet
intermediate_data_whole_genome/block_length.parquet
intermediate_data_whole_genome/variants.nozeros.parquet

# Keep notebooks in notebooks_fullgenome (unignore directory and .ipynb files)
!notebooks_fullgenome/
!notebooks_fullgenome/*.ipynb

# I want to hang on to the claude refactored fig 6 scripts, but I want to upload just the original script for now.
scripts/*R
!scripts/Figure_6_script.R

!README.md
