# Copy this file to `docker.env` and edit the paths for your machine.
# The Docker smoke test is reproducible, but not self-contained:
# large biological inputs are intentionally not stored in git.

IMAGE_NAME=phasing-t2t
CONTAINER_NAME=phasing-t2t-smoke
NUM_THREADS=12
RUN_SUFFIX=smoke
RUN_NOTEBOOKS=0

# Host output directory for generated working files and results.
OUTPUT_DIR=./docker_smoke_output

# Required reference genomes.
CHM13_FA=/absolute/path/to/chm13v2.0.fa.gz
GRCH38_FA=/absolute/path/to/GRCh38_full_analysis_set_plus_decoy_hla.fa.gz

# Required input directories.
UNPHASED_T2T_DIR=/absolute/path/to/unphased_variant_calls/t2t
UNPHASED_GRCH38_DIR=/absolute/path/to/unphased_variant_calls/grch38
GRCH38_PANELS_DIR=/absolute/path/to/phased_panels/grch38
SGDP_GRCH38_DIR=/absolute/path/to/SGDP_variation/grch38
SGDP_T2T_DIR=/absolute/path/to/SGDP_variation/t2t

# Required pangenome VCFs and indexes.
HPRC_CHM13_VCF=/absolute/path/to/hprc-v1.1-mc-chm13.vcfbub.a100k.wave.vcf.gz
HPRC_GRCH38_VCF=/absolute/path/to/hprc-v1.1-mc-grch38.vcfbub.a100k.wave.vcf.gz
HGSVC3_CHM13_VCF=/absolute/path/to/hgsvc3-2024-02-23-mc-chm13-vcfbub.a100k.wave.norm.vcf.gz
HGSVC3_CHM13_GRCH38_VCF=/absolute/path/to/hgsvc3-2024-02-23-mc-chm13.GRCh38-vcfbub.a100k.wave.norm.vcf.gz
HGSVC3_HPRC_CHM13_VCF=/absolute/path/to/hgsvc3-hprc-2024-02-23-mc-chm13-vcfbub.a100k.wave.norm.vcf.gz
HGSVC3_HPRC_CHM13_GRCH38_VCF=/absolute/path/to/hgsvc3-hprc-2024-02-23-mc-chm13.GRCh38-vcfbub.a100k.wave.norm.vcf.gz
