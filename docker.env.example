# Copy this file to `docker.env`.
# `scripts/run_docker_smoke_test.sh` defines PROJECT_DIR before sourcing this file.
# If you populated the canonical repo-local inputs with
# `bash scripts/utility/download_resources.sh --test` (or the full download mode),
# the paths below should work without edits. Change them only if your inputs live
# somewhere else on the host.

IMAGE_NAME=jlalli/phasing_t2t_dep_container:v2.0
CONTAINER_NAME=phasing-t2t-smoke
NUM_THREADS=12
RUN_SUFFIX=smoke
RUN_NOTEBOOKS=1

# Host output directory for generated test working files, figures, tables, and executed notebooks.
# The default writes to the repo's plain test folders: intermediate_data,
# imputation_statistics, figures, tables, and notebook_runs.
OUTPUT_DIR="${PROJECT_DIR}"

# Required reference genomes.
CHM13_FA="${PROJECT_DIR}/resources/chm13v2.0.fa.gz"
GRCH38_FA="${PROJECT_DIR}/resources/GRCh38_full_analysis_set_plus_decoy_hla.fa.gz"

# Required input directories.
UNPHASED_T2T_DIR="${PROJECT_DIR}/unphased_variant_calls/t2t"
UNPHASED_GRCH38_DIR="${PROJECT_DIR}/unphased_variant_calls/grch38"
GRCH38_PANELS_DIR="${PROJECT_DIR}/phased_panels/grch38"
SGDP_GRCH38_DIR="${PROJECT_DIR}/resources/SGDP_variation/grch38"
SGDP_T2T_DIR="${PROJECT_DIR}/resources/SGDP_variation/t2t"

# Required pangenome VCFs and indexes.
HPRC_CHM13_VCF="${PROJECT_DIR}/resources/hprc-v1.1-mc-chm13.vcfbub.a100k.wave.vcf.gz"
HPRC_GRCH38_VCF="${PROJECT_DIR}/resources/hprc-v1.1-mc-grch38.vcfbub.a100k.wave.vcf.gz"
HGSVC3_CHM13_VCF="${PROJECT_DIR}/resources/hgsvc3-2024-02-23-mc-chm13-vcfbub.a100k.wave.norm.vcf.gz"
HGSVC3_CHM13_GRCH38_VCF="${PROJECT_DIR}/resources/hgsvc3-2024-02-23-mc-chm13.GRCh38-vcfbub.a100k.wave.norm.vcf.gz"
HGSVC3_HPRC_CHM13_VCF="${PROJECT_DIR}/resources/hgsvc3-hprc-2024-02-23-mc-chm13-vcfbub.a100k.wave.norm.vcf.gz"
HGSVC3_HPRC_CHM13_GRCH38_VCF="${PROJECT_DIR}/resources/hgsvc3-hprc-2024-02-23-mc-chm13.GRCh38-vcfbub.a100k.wave.norm.vcf.gz"
